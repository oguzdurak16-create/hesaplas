{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "hesaplas.com"
        }
      ],
      "destination": "https://www.hesaplas.com/:path*",
      "permanent": true
    }
  ]
}
